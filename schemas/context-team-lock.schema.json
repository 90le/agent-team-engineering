{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:context-team-lock:1.0.0",
  "title": "Context-first Agent Team lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "team_id", "mode", "factory", "design_digest", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "team_id": {"type": "string", "pattern": "^team\\.[a-z0-9][a-z0-9.-]*$"},
    "mode": {"enum": ["lite", "managed"]},
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source_revision", "source_dirty"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_dirty": {"type": "boolean"}
      }
    },
    "design_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "management"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "management": {"enum": ["generated", "user-maintained"]}
        }
      }
    }
  }
}
