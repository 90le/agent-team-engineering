{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:instance-recovery-manifest:1.0.0",
  "title": "Agent Team instance recovery bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "instance_id", "plan_id", "captured_factory_version", "expected_factory_version", "captured_lock_digest", "expected_lock_digest", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^recovery-[a-f0-9]{32}$"},
    "instance_id": {"type": "string", "pattern": "^instance\\.[a-z0-9][a-z0-9.-]*$"},
    "plan_id": {"type": "string", "pattern": "^(upgrade|rollback)-[a-f0-9]{32}$"},
    "captured_factory_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "expected_factory_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "captured_lock_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "expected_lock_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1001,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "existed", "sha256", "mode", "expected_after_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "existed": {"type": "boolean"},
          "sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
          "mode": {"type": ["integer", "null"], "minimum": 0, "maximum": 511},
          "expected_after_sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    }
  }
}
