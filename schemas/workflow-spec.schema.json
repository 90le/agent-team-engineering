{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:workflow-spec:1.0.0",
  "title": "Vendor-neutral WorkflowSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "workflow_id", "workflow_version", "name", "initial_state", "states", "terminal_states", "transitions", "default_stop_state"],
  "properties": {
    "$schema": {"const": "urn:agent-team:schema:workflow-spec:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "workflow_id": {"type": "string", "pattern": "^workflow\\.[a-z0-9][a-z0-9.-]*$", "maxLength": 120},
    "workflow_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "initial_state": {"const": "RECEIVED"},
    "states": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["RECEIVED", "NORMALIZED", "TRIAGED", "PLANNED", "AWAITING_APPROVAL", "APPROVED", "EXECUTING", "VERIFYING", "REVIEWING", "CHANGES_REQUESTED", "DRAFT_PR_READY", "COMPLETED", "REJECTED", "DUPLICATE", "NEEDS_HUMAN", "CANCELLED", "EXPIRED", "FAILED", "BLOCKED"]}},
    "terminal_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["COMPLETED", "REJECTED", "DUPLICATE", "CANCELLED", "EXPIRED", "FAILED"]}},
    "default_stop_state": {"const": "DRAFT_PR_READY"},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "from_state", "to_state", "required_role", "requires_approval", "required_evidence", "retry"],
        "properties": {
          "event": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "from_state": {"type": "string"},
          "to_state": {"type": "string"},
          "required_role": {"type": ["string", "null"], "pattern": "^role\\.[a-z0-9][a-z0-9.-]*$"},
          "requires_approval": {"type": "boolean"},
          "required_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maximum_attempts", "timeout_seconds", "on_exhausted"],
            "properties": {
              "maximum_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
              "on_exhausted": {"enum": ["BLOCKED", "FAILED", "NEEDS_HUMAN"]}
            }
          }
        }
      }
    }
  }
}
