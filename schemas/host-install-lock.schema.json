{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:host-install-lock:1.0.0",
  "title": "Host-native team installation lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "team_id", "host", "proposal_digest", "destination", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["APPLYING", "ACTIVE"]},
    "team_id": {"type": "string", "pattern": "^team\\.[a-z0-9][a-z0-9.-]*$"},
    "host": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "proposal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "destination": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
