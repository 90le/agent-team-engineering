{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:host-install-lock:1.1.0",
  "title": "Host-native team installation lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "team_id", "host", "proposal_digest", "destination", "guard_binding", "proposal", "files"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "status": {"enum": ["APPLYING", "ACTIVE", "UNINSTALLING"]},
    "team_id": {"type": "string", "pattern": "^team\\.[a-z0-9][a-z0-9.-]*$"},
    "host": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "proposal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "destination": {"type": "string", "minLength": 1},
    "guard_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size", "device", "inode"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size": {"const": 0},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1}
      }
    },
    "proposal": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "stage_path", "sha256", "binding", "state"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "stage_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "binding": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["sha256", "size", "device", "inode"],
            "properties": {
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 0},
              "device": {"type": "integer", "minimum": 0},
              "inode": {"type": "integer", "minimum": 1}
            }
          },
          "state": {"enum": ["PLANNED", "PRESENT", "QUARANTINED", "REMOVED"]}
        }
      }
    }
  }
}
