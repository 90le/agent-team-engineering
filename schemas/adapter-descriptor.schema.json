{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:adapter-descriptor:1.0.0",
  "title": "Replaceable AdapterDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "adapter_id", "adapter_version", "status", "ports", "core_contract_versions", "external_product", "capabilities", "permissions", "limitations", "timeouts", "idempotency", "health_check"],
  "properties": {
    "$schema": {"const": "urn:agent-team:schema:adapter-descriptor:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "adapter_id": {"type": "string", "pattern": "^adapter\\.[a-z0-9][a-z0-9.-]*$", "maxLength": 120},
    "adapter_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "status": {"enum": ["REFERENCE", "EXPERIMENTAL", "STABLE"]},
    "ports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ingress", "identity", "scm", "agent-executor", "sandbox", "ci", "state-store", "evidence", "notification", "secret"]}},
    "core_contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum_exclusive"],
      "properties": {
        "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "maximum_exclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "external_product": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "version", "api_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "api_version": {"type": ["string", "null"], "maxLength": 100}
      }
    },
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.:/-]*$"}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connect_seconds", "operation_seconds", "cancel_seconds"],
      "properties": {
        "connect_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "operation_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "cancel_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "idempotency": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "mode"],
        "properties": {
          "port": {"type": "string"},
          "mode": {"enum": ["read-only", "provider-key", "reconcile-before-retry", "at-most-once"]}
        }
      }
    },
    "health_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timeout_seconds"],
      "properties": {
        "mode": {"enum": ["local", "remote", "composite"]},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    }
  }
}
