{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:approval-grant:1.1.0",
  "title": "Exact and time-bound ApprovalGrant",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "required": ["$schema", "schema_version"],
      "properties": {
        "$schema": {"const": "urn:agent-team:schema:approval-grant:1.0.0"},
        "schema_version": {"const": "1.0.0"}
      },
      "not": {"required": ["writer_topology"]}
    },
    {
      "required": ["$schema", "schema_version", "writer_topology"],
      "properties": {
        "$schema": {"const": "urn:agent-team:schema:approval-grant:1.1.0"},
        "schema_version": {"const": "1.1.0"}
      }
    }
  ],
  "required": ["$schema", "schema_version", "approval_id", "actor_id", "identity_provider", "work_item_id", "plan_revision", "plan_digest", "repository_id", "base_commit", "allowed_paths", "allowed_actions", "runner_profile", "agent_capabilities", "budget_limit", "time_limit_seconds", "merge_allowed", "deploy_allowed", "issued_at", "expires_at", "nonce", "evidence_ref", "signature_ref", "scope_digest"],
  "properties": {
    "$schema": {"enum": ["urn:agent-team:schema:approval-grant:1.0.0", "urn:agent-team:schema:approval-grant:1.1.0"]},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "approval_id": {"type": "string", "pattern": "^approval-[a-z0-9][a-z0-9-]*$", "maxLength": 120},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "identity_provider": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
    "work_item_id": {"type": "string", "pattern": "^work-[a-z0-9][a-z0-9-]*$", "maxLength": 120},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "repository_id": {"type": "string", "pattern": "^repo\\.[a-z0-9][a-z0-9.-]*$"},
    "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "writer_topology": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["topology_id", "topology_version", "topology_digest"],
      "properties": {
        "topology_id": {"type": "string", "pattern": "^topology\\.[a-z0-9][a-z0-9.-]*$", "maxLength": 120},
        "topology_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "topology_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repository.read", "workspace.write", "test.run", "commit.create", "draft-pr.create", "ci.read"]}},
    "runner_profile": {"type": "string", "pattern": "^runner\\.[a-z0-9][a-z0-9.-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "agent_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
    "budget_limit": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "time_limit_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "merge_allowed": {"const": false},
    "deploy_allowed": {"const": false},
    "issued_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "expires_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9._-]{16,200}$"},
    "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "signature_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "scope_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
