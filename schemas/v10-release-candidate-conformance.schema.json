{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:v10-release-candidate-conformance:1.0.0",
  "title": "Agent Team Engineering v1.0 release-candidate conformance",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "factory_release", "status", "observed_at", "baseline", "hosts", "unknown_hosts", "local_gates", "supply_chain", "authority_boundaries", "remote_gates"],
  "properties": {
    "$schema": {"const": "schemas/v10-release-candidate-conformance.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "factory_release": {"const": "v1.0.0"},
    "status": {"const": "PRE_RELEASE"},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": {"const": "v0.9.0"},
        "commit": {"const": "a286cfadbfb6f387a4f1fb94c244f57d4dd089e6"}
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "prefixItems": [
        {"properties": {"host_id": {"const": "codex"}}},
        {"properties": {"host_id": {"const": "claude"}}},
        {"properties": {"host_id": {"const": "openclaw"}}},
        {"properties": {"host_id": {"const": "hermes"}}},
        {"properties": {"host_id": {"const": "multica"}}},
        {"properties": {"host_id": {"const": "generic-ai"}}}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_id", "support_tier", "evidence_scope", "version_or_release", "production_execution"],
        "properties": {
          "host_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "support_tier": {"enum": ["native-install-verified", "verified-export", "experimental-plan", "portable"]},
          "evidence_scope": {"type": "string", "minLength": 1},
          "version_or_release": {"type": ["string", "null"]},
          "production_execution": {"const": false}
        }
      }
    },
    "unknown_hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "support_tier", "reason"],
        "properties": {
          "name": {"const": "Leda"},
          "support_tier": {"const": "research-unknown"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "local_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_validation", "unit_tests", "writer_authority", "host_lifecycle", "instance_migration", "skills_and_plugins", "isolated_hosts", "cold_start", "release_smoke", "external_scm"],
      "properties": {
        "repository_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "command", "errors", "findings"],
          "properties": {
            "status": {"const": "PASS"},
            "command": {"const": "./agent-team validate"},
            "errors": {"const": 0},
            "findings": {"const": 0}
          }
        },
        "unit_tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "command", "count"],
          "properties": {
            "status": {"const": "PASS"},
            "command": {"const": "python3 -m unittest discover -s tests -v"},
            "count": {"type": "integer", "minimum": 1}
          }
        },
        "writer_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "test_count", "topology_digest", "plan_digest", "approval_scope_digest", "automatic_execution", "identity_or_signature_verified"],
          "properties": {
            "status": {"const": "PASS"},
            "test_count": {"type": "integer", "minimum": 1},
            "topology_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "approval_scope_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "automatic_execution": {"const": false},
            "identity_or_signature_verified": {"const": false}
          }
        },
        "host_lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "test_count", "plan_schema", "lock_schema", "guard_mode", "legacy_destructive_uninstall"],
          "properties": {
            "status": {"const": "PASS"},
            "test_count": {"type": "integer", "minimum": 1},
            "plan_schema": {"const": "1.1.0"},
            "lock_schema": {"const": "1.1.0"},
            "guard_mode": {"const": "empty-regular-file-v1"},
            "legacy_destructive_uninstall": {"const": false}
          }
        },
        "instance_migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source_versions", "target_version", "rollback_tested"],
          "properties": {
            "status": {"const": "PASS"},
            "source_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}},
            "target_version": {"const": "1.0.0"},
            "rollback_tested": {"const": true}
          }
        },
        "skills_and_plugins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "skill_packages", "plugin_manifests"],
          "properties": {
            "status": {"const": "PASS"},
            "skill_packages": {"type": "integer", "minimum": 1},
            "plugin_manifests": {"type": "integer", "minimum": 1}
          }
        },
        "isolated_hosts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "load_tests", "hosts"],
          "properties": {
            "status": {"enum": ["PASS", "NOT_RUN"]},
            "load_tests": {"type": "integer", "minimum": 0},
            "hosts": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["openclaw", "hermes"]}}
          }
        },
        "cold_start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "runs", "command"],
          "properties": {
            "status": {"enum": ["PASS", "NOT_RUN"]},
            "runs": {"type": "integer", "minimum": 0},
            "command": {"const": "tools/cold-start.sh"}
          }
        },
        "release_smoke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "runs", "command"],
          "properties": {
            "status": {"enum": ["PASS", "NOT_RUN"]},
            "runs": {"type": "integer", "minimum": 0},
            "command": {"const": "tools/release-smoke.sh"}
          }
        },
        "external_scm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "live_runs", "evidence_files"],
          "properties": {
            "status": {"enum": ["PASS", "NOT_RUN"]},
            "live_runs": {"type": "integer", "minimum": 0},
            "evidence_files": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sbom", "source_provenance", "copied_external_source_files"],
      "properties": {
        "sbom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "sbom/agent-team-engineering.spdx.json"},
            "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "source_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "supply-chain/source-provenance.json"},
            "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "copied_external_source_files": {"const": false}
      }
    },
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_host_credentials_read", "production_credentials_read", "ai_host_accounts_used", "production_accounts_used", "channels_bound", "models_invoked", "tasks_started", "automatic_merge", "automatic_deploy", "identity_or_signature_verified_offline", "independent_writer_execution", "dedicated_scm_identity_used", "ephemeral_scm_token_used", "external_scm_write_scope"],
      "properties": {
        "ai_host_credentials_read": {"const": false},
        "production_credentials_read": {"const": false},
        "ai_host_accounts_used": {"const": false},
        "production_accounts_used": {"const": false},
        "channels_bound": {"const": false},
        "models_invoked": {"const": false},
        "tasks_started": {"const": false},
        "automatic_merge": {"const": false},
        "automatic_deploy": {"const": false},
        "identity_or_signature_verified_offline": {"const": false},
        "independent_writer_execution": {"const": false},
        "dedicated_scm_identity_used": {"type": "boolean"},
        "ephemeral_scm_token_used": {"type": "boolean"},
        "external_scm_write_scope": {"enum": ["NONE", "GRANTED_DEDICATED_TEST_ONLY"]}
      }
    },
    "remote_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pull_request_ci", "merged_main_ci", "annotated_tag", "tag_workflow", "github_release", "anonymous_install"],
      "properties": {
        "pull_request_ci": {"const": "NOT_RUN_IN_SOURCE"},
        "merged_main_ci": {"const": "NOT_RUN_IN_SOURCE"},
        "annotated_tag": {"const": "NOT_RUN_IN_SOURCE"},
        "tag_workflow": {"const": "NOT_RUN_IN_SOURCE"},
        "github_release": {"const": "NOT_RUN_IN_SOURCE"},
        "anonymous_install": {"const": "NOT_RUN_IN_SOURCE"}
      }
    }
  }
}
