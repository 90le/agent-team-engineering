{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:adoption-package:1.0.0",
  "title": "Digest-bound proposal-only project adoption package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "project_id", "provider", "locator", "default_branch", "mode", "source_path", "source_commit", "source_dirty", "target_repository_mutated", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^adoption-[a-f0-9]{32}$"},
    "project_id": {"type": "string", "pattern": "^project\\.[a-z0-9][a-z0-9._-]*$"},
    "provider": {"enum": ["github", "gitlab", "gitea", "generic-git"]},
    "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
    "default_branch": {"type": "string", "minLength": 1, "maxLength": 500},
    "mode": {"const": "proposal-only"},
    "source_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
    "source_dirty": {"type": ["boolean", "null"]},
    "target_repository_mutated": {"const": false},
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0, "maximum": 1000000}
        }
      }
    }
  }
}
