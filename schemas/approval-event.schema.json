{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:approval-event:1.0.0",
  "title": "Bound Approval Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "work_item_id", "revision", "actor_id", "action", "decision", "issued_at", "expires_at"],
  "properties": {
    "approval_id": {"type": "string"},
    "work_item_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "actor_id": {"type": "string"},
    "action": {"type": "string"},
    "decision": {"enum": ["APPROVED", "REJECTED"]},
    "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature_ref": {"type": ["string", "null"]}
  }
}
