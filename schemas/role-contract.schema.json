{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:role-contract:1.0.0",
  "title": "Vendor-neutral RoleContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "role_id", "role_version", "name", "responsibilities", "non_responsibilities", "minimum_context_refs", "input_contracts", "output_contracts", "required_capabilities", "allowed_actions", "forbidden_actions", "resource_limits", "handoff", "completion_evidence", "stop_conditions"],
  "properties": {
    "$schema": {"const": "urn:agent-team:schema:role-contract:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "role_id": {"type": "string", "pattern": "^role\\.[a-z0-9][a-z0-9.-]*$", "maxLength": 120},
    "role_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "responsibilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "non_responsibilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "minimum_context_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "input_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^urn:agent-team:schema:[a-z0-9-]+:[0-9]+\\.[0-9]+\\.[0-9]+$"}},
    "output_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^urn:agent-team:schema:[a-z0-9-]+:[0-9]+\\.[0-9]+\\.[0-9]+$"}},
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
    "forbidden_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_sessions", "max_duration_seconds", "max_cost_units"],
      "properties": {
        "max_sessions": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_cost_units": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to_roles", "required_evidence_types"],
      "properties": {
        "to_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^role\\.[a-z0-9][a-z0-9.-]*$"}},
        "required_evidence_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}}
      }
    },
    "completion_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
    "stop_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
