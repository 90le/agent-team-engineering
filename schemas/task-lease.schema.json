{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:task-lease:1.0.0",
  "title": "Persistent agent task lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["lease_id", "work_item_id", "actor_id", "actor_role", "revision", "expires_at"],
  "properties": {
    "lease_id": {"type": "string", "pattern": "^lease-[a-f0-9-]+$"},
    "work_item_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "actor_role": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "number", "minimum": 0}
  }
}
