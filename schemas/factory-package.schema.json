{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:factory-package:1.0.0",
  "title": "Agent Team Factory package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "status", "instance_schema_version", "maximum_bootstrap_autonomy", "management_skill", "team_packs", "contract_files"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^factory\\.[a-z0-9][a-z0-9.-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "status": {"enum": ["DEVELOPMENT", "RELEASE_CANDIDATE", "STABLE", "DEPRECATED"]},
    "instance_schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "maximum_bootstrap_autonomy": {"enum": ["A0", "A1", "A2"]},
    "management_skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "team_packs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^team-pack\\.[a-z0-9][a-z0-9.-]*$"},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "contract_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
