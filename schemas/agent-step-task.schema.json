{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:agent-step-task:1.0.0",
  "title": "Project-bound executable agent step",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "work_item_id", "project_id", "role", "action", "expected_revision", "idempotency_key", "prompt", "context", "allowed_capabilities", "budget"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "work_item_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "project_id": {"type": "string", "pattern": "^project\\.[a-z0-9][a-z0-9._-]*$"},
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 50000},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_commit", "project_base_commit", "project_commit", "paths"],
      "properties": {
        "framework_commit": {"type": "string", "minLength": 1},
        "project_base_commit": {"type": "string", "minLength": 1},
        "project_commit": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "allowed_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "max_seconds", "max_cost_units"],
      "properties": {
        "max_attempts": {"const": 1},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_cost_units": {"type": "number", "minimum": 0}
      }
    }
  }
}
