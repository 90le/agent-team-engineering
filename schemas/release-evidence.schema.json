            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "number": {"type": ["integer", "null"], "minimum": 1},
            "url": {"type": ["string", "null"]},
            "head_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
            "merged_at": {"type": ["string", "null"], "format": "date-time"},
            "checks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "url", "app_id", "completed_at"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "url": {"type": "string", "pattern": "^https://[^@/]+(?:/.*)?$"},
                  "app_id": {"type": ["integer", "null"], "minimum": -1},
                  "completed_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        },
        "technical_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "head_commit", "head_tree", "workflow_commit", "reviewer_kind", "reviewer_runtime", "evidence_url", "evidence_sha256", "decision", "authenticated_human", "generated_at", "completed_at"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "head_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
            "head_tree": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
            "workflow_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
            "reviewer_kind": {"enum": ["independent-ai", null]},
            "reviewer_runtime": {"type": ["string", "null"], "minLength": 1},
            "evidence_url": {"type": ["string", "null"], "pattern": "^https://github\\.com/90le/agent-team-v10-review-private/actions/runs/[0-9]+$"},
            "evidence_sha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
            "decision": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "authenticated_human": {"const": false},
            "generated_at": {"type": ["string", "null"], "format": "date-time"},
            "completed_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "owner_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "head_commit", "reviewer", "reviewer_kind", "url", "decision", "submitted_at"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "head_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
            "reviewer": {"type": ["string", "null"], "minLength": 1},
            "reviewer_kind": {"enum": ["github-user", null]},
            "url": {"type": ["string", "null"], "pattern": "^https://github\\.com/90le/agent-team-engineering/pull/[0-9]+#pullrequestreview-[0-9]+$"},
            "decision": {"enum": ["APPROVED", "CHANGES_REQUESTED", "DISMISSED", "NOT_RUN"]},
            "submitted_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "merged_main": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "ref", "commit", "tree", "checks"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "ref": {"enum": ["refs/heads/main", null]},
            "commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
            "tree": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
            "checks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "url", "app_id", "completed_at"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "url": {"type": "string", "pattern": "^https://[^@/]+(?:/.*)?$"},
                  "app_id": {"type": ["integer", "null"], "minimum": -1},
                  "completed_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        },
        "annotated_tag": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "name", "object_type", "object_id", "peeled_commit", "tagger_name", "tagger_email", "tagged_at", "signature_verified", "signature_reason"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "name": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "object_type": {"type": ["string", "null"]},
            "object_id": {"type": ["string", "null"]},
            "peeled_commit": {"type": ["string", "null"]},
            "tagger_name": {"type": ["string", "null"]},
            "tagger_email": {"type": ["string", "null"]},
            "tagged_at": {"type": ["string", "null"], "format": "date-time"},
            "signature_verified": {"type": ["boolean", "null"]},
            "signature_reason": {"type": ["string", "null"]}
          }
        },
        "tag_workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "run_id", "run_attempt", "url", "actor", "actor_id", "completed_at"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "provider": {"const": "github.actions"},
            "run_id": {"type": ["string", "null"]},
            "run_attempt": {"type": ["string", "null"]},
            "url": {"type": ["string", "null"]},
            "actor": {"type": ["string", "null"]},
            "actor_id": {"type": ["integer", "null"], "minimum": 1},
            "completed_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "evidence_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "name", "id", "url", "archive_download_url", "digest", "retention_days", "created_at", "expires_at", "download_status", "downloaded_at", "downloaded_archive_digest", "tag_evidence_sha256", "checksums_sha256"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "name": {"type": "string", "pattern": "^release-evidence-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "id": {"type": ["integer", "null"], "minimum": 1},
            "url": {"type": ["string", "null"]},
            "archive_download_url": {"type": ["string", "null"]},
            "digest": {"type": ["string", "null"]},
            "retention_days": {"type": ["integer", "null"], "minimum": 1},
            "created_at": {"type": ["string", "null"]},
            "expires_at": {"type": ["string", "null"]},
            "download_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "downloaded_at": {"type": ["string", "null"]},
            "downloaded_archive_digest": {"type": ["string", "null"]},
            "tag_evidence_sha256": {"type": ["string", "null"]},
            "checksums_sha256": {"type": ["string", "null"]}
          }
        },
        "github_release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "url", "tag", "draft", "prerelease", "author", "author_id", "published_at"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "url": {"type": ["string", "null"]},
            "tag": {"type": ["string", "null"]},
            "draft": {"type": ["boolean", "null"]},
            "prerelease": {"type": ["boolean", "null"]},
            "author": {"type": ["string", "null"]},
            "author_id": {"type": ["integer", "null"], "minimum": 1},
            "published_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "anonymous_install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "workflow_url", "source_url", "tag", "tag_object", "commit", "verified_at", "commands", "unauthenticated_git_transport", "caller_credentials_inherited", "same_uid_filesystem_isolated", "write_isolation", "external_writes_verified", "candidate_network_isolated", "candidate_runtime_read_only", "credential_process_uid_isolated", "credential_parent_environment_readable", "supplementary_groups_empty", "no_new_privileges", "capabilities_empty", "isolation_mechanism", "resource_isolation"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "workflow_url": {"type": ["string", "null"]},
            "source_url": {"type": ["string", "null"]},
            "tag": {"type": ["string", "null"]},
            "tag_object": {"type": ["string", "null"]},
            "commit": {"type": ["string", "null"]},
            "verified_at": {"type": ["string", "null"]},
            "commands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "unauthenticated_git_transport": {"enum": [true, null]},
            "caller_credentials_inherited": {"enum": [false, null]},
            "same_uid_filesystem_isolated": {"enum": [true, null]},
            "write_isolation": {"enum": [true, null]},
            "external_writes_verified": {"enum": [true, null]},
            "candidate_network_isolated": {"enum": [true, null]},
            "candidate_runtime_read_only": {"enum": [true, null]},
            "credential_process_uid_isolated": {"enum": [true, null]},
            "credential_parent_environment_readable": {"enum": [false, null]},
            "supplementary_groups_empty": {"enum": [true, null]},
            "no_new_privileges": {"enum": [true, null]},
            "capabilities_empty": {"enum": [true, null]},
            "isolation_mechanism": {"enum": ["linux-systemd-cgroup-setpriv-bubblewrap-v1", null]},
            "resource_isolation": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["cgroup_v2", "process_tree_cgroup_isolated", "bounded_output_capture", "memory_max_bytes", "memory_swap_max_bytes", "tasks_max", "cpu_quota_percent", "file_size_limit_bytes", "temporary_filesystem_limit_bytes"],
