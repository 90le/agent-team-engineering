                "tag": {"type": "string", "minLength": 1},
                "tag_object": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "verified_at": {"type": "string", "format": "date-time"},
                "commands": {"type": "array", "minItems": 1},
                "unauthenticated_git_transport": {"const": true},
                "caller_credentials_inherited": {"const": false},
                "same_uid_filesystem_isolated": {"const": true},
                "write_isolation": {"const": true},
                "external_writes_verified": {"const": true},
                "credential_process_uid_isolated": {"const": true},
                "credential_parent_environment_readable": {"const": false},
                "supplementary_groups_empty": {"const": true},
                "no_new_privileges": {"const": true},
                "capabilities_empty": {"const": true},
                "resource_isolation": {"type": "object"},
                "candidate_network_isolated": {"const": true},
                "candidate_runtime_read_only": {"const": true},
                "isolation_mechanism": {"const": "linux-systemd-cgroup-setpriv-bubblewrap-v1"}
              }
            }
          }
        },
        "gates": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "prefixItems": [
            {"properties": {"id": {"const": "repository-validation"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "unit-tests"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "writer-authority"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "host-lifecycle"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "instance-migration"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "skills-plugins"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "isolated-hosts"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "cold-start"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "release-smoke"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "external-scm"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "supply-chain"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "public-documentation"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "pull-request"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "technical-review"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "owner-approval"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "merged-main"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "annotated-tag"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "tag-workflow"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "evidence-artifact-download"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "github-release"}, "status": {"const": "PASS"}}},
            {"properties": {"id": {"const": "anonymous-install"}, "status": {"const": "PASS"}}}
          ]
        }
      }
