                "ref": {"const": "refs/heads/main"},
                "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "checks": {"type": "array", "minItems": 1}
              }
            },
            "annotated_tag": {
              "properties": {
                "status": {"const": "PASS"},
                "object_type": {"const": "tag"},
