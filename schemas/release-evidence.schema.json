          "exit_code": {"const": 0}
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "bundle_path", "sha256", "size_bytes"],
        "properties": {
          "kind": {"enum": ["v10-candidate-conformance", "sbom", "source-provenance", "external-scm-first-run", "external-scm-replay"]},
          "path": {"type": "string", "minLength": 1},
          "bundle_path": {"type": "string", "pattern": "^bundle/[A-Za-z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pull_request", "technical_review", "owner_approval", "merged_main", "annotated_tag", "tag_workflow", "evidence_artifact", "github_release", "anonymous_install"],
      "properties": {
        "pull_request": {
          "type": "object",
