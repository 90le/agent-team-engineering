                "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                "retention_days": {"type": "integer", "minimum": 1},
                "created_at": {"type": "string", "format": "date-time"},
                "expires_at": {"type": "string", "format": "date-time"},
                "download_status": {"const": "PASS"},
                "downloaded_at": {"type": "string", "format": "date-time"},
                "downloaded_archive_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                "tag_evidence_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                "checksums_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
              }
            },
            "github_release": {
              "properties": {
                "status": {"const": "PASS"},
                "url": {"type": "string", "minLength": 1},
                "tag": {"type": "string", "minLength": 1},
                "draft": {"const": false},
                "prerelease": {"const": false},
                "author": {"type": "string", "minLength": 1},
                "author_id": {"type": "integer", "minimum": 1},
