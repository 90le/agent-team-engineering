                "run_attempt": {"type": "string", "minLength": 1},
                "url": {"type": "string", "minLength": 1},
                "actor": {"type": "string", "minLength": 1},
                "actor_id": {"type": "integer", "minimum": 1},
                "completed_at": {"type": "string", "format": "date-time"}
              }
            },
            "evidence_artifact": {
              "properties": {
                "status": {"const": "PASS"},
