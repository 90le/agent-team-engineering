                "merged_at": {"type": "string", "format": "date-time"},
                "checks": {"type": "array", "minItems": 1}
              }
            },
            "technical_review": {
              "properties": {
                "status": {"const": "PASS"},
                "head_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "head_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "workflow_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "reviewer_kind": {"const": "independent-ai"},
                "reviewer_runtime": {"type": "string", "minLength": 1},
                "evidence_url": {"type": "string", "minLength": 1},
                "evidence_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
