{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:run:1.0.0",
  "title": "Bounded execution Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "run_id", "work_item_id", "plan_id", "plan_revision", "plan_digest", "approval_id", "state", "revision", "attempt", "lease", "worker_sessions", "cost_units_used", "started_at", "updated_at", "artifact_refs", "evidence_bundle_refs", "idempotency_keys"],
  "properties": {
    "$schema": {"const": "urn:agent-team:schema:run:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]*$", "maxLength": 120},
    "work_item_id": {"type": "string", "pattern": "^work-[a-z0-9][a-z0-9-]*$"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9][a-z0-9-]*$"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "approval_id": {"type": "string", "pattern": "^approval-[a-z0-9][a-z0-9-]*$"},
    "state": {"enum": ["APPROVED", "EXECUTING", "VERIFYING", "REVIEWING", "CHANGES_REQUESTED", "DRAFT_PR_READY", "COMPLETED", "CANCELLED", "EXPIRED", "FAILED", "BLOCKED"]},
    "revision": {"type": "integer", "minimum": 0},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 100},
    "lease": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["lease_id", "worker_id", "acquired_at", "expires_at"],
      "properties": {
        "lease_id": {"type": "string", "pattern": "^lease-[a-z0-9][a-z0-9-]*$"},
        "worker_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "acquired_at": {"type": "string", "format": "date-time", "maxLength": 40},
        "expires_at": {"type": "string", "format": "date-time", "maxLength": 40}
      }
    },
    "worker_sessions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "cost_units_used": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "started_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "updated_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "evidence_bundle_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "idempotency_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
  }
}
