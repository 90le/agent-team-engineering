{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:capability-package:1.0.0",
  "title": "Portable Capability Package",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "id", "name", "version", "status", "owner", "entrypoint", "sensitivity", "triggers", "adapters", "updated_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "id": {"type": "string", "pattern": "^capability\\.[a-z0-9][a-z0-9.-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["PLANNED", "ACTIVE", "DEPRECATED", "RETIRED"]},
    "owner": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "sensitivity": {"enum": ["L0-PUBLIC", "L1-PRIVATE", "L2-SENSITIVE", "L3-SECRET"]},
    "triggers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "adapters": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "updated_at": {"type": "string"}
  }
}
