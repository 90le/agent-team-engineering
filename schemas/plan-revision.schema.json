{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:plan-revision:1.1.0",
  "title": "Immutable PlanRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "plan_id", "work_item_id", "revision", "previous_plan_digest", "repository_id", "base_commit", "objective", "assumptions", "tasks", "allowed_paths", "allowed_actions", "tests", "risk_level", "rollback", "budget_limit", "time_limit_seconds", "created_by", "created_at", "plan_digest"],
  "properties": {
    "$schema": {"enum": ["urn:agent-team:schema:plan-revision:1.0.0", "urn:agent-team:schema:plan-revision:1.1.0"]},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9][a-z0-9-]*$", "maxLength": 120},
    "work_item_id": {"type": "string", "pattern": "^work-[a-z0-9][a-z0-9-]*$", "maxLength": 120},
    "revision": {"type": "integer", "minimum": 1},
    "previous_plan_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "repository_id": {"type": "string", "pattern": "^repo\\.[a-z0-9][a-z0-9.-]*$"},
    "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "writer_topology": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["topology_id", "topology_version", "topology_digest"],
      "properties": {
        "topology_id": {"type": "string", "pattern": "^topology\\.[a-z0-9][a-z0-9.-]*$", "maxLength": 120},
        "topology_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "topology_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "role_id", "objective", "depends_on", "required_capabilities", "completion_evidence"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]*$"},
          "role_id": {"type": "string", "pattern": "^role\\.[a-z0-9][a-z0-9.-]*$"},
          "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]*$"}},
          "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
          "completion_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}}
        }
      }
    },
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repository.read", "workspace.write", "test.run", "commit.create", "draft-pr.create", "ci.read"]}},
    "tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "rollback": {"type": "string", "minLength": 1, "maxLength": 4000},
    "budget_limit": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "time_limit_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "created_by": {"type": "string", "pattern": "^role\\.[a-z0-9][a-z0-9.-]*$"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
