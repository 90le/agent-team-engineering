{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:team-instance-lock:1.0.0",
  "title": "Agent Team instance lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "factory", "team_pack", "instance_digest", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "instance_id": {"type": "string", "pattern": "^instance\\.[a-z0-9][a-z0-9.-]*$"},
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source_revision", "source_dirty", "contract_digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^factory\\.[a-z0-9][a-z0-9.-]*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "source_revision": {"type": "string", "minLength": 1},
        "source_dirty": {"type": "boolean"},
        "contract_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "team_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^team-pack\\.[a-z0-9][a-z0-9.-]*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "instance_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ownership", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "ownership": {"enum": ["managed", "seeded"]},
          "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    }
  }
}
