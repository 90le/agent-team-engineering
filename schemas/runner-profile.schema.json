{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:runner-profile:1.0.0",
  "title": "Explicit host runner profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "working_directory", "commands"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^project\\.[a-z0-9][a-z0-9._-]*$"},
    "working_directory": {"type": "string", "minLength": 1, "maxLength": 500},
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "timeout_seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,99}$"},
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {"type": "string", "minLength": 1, "maxLength": 1000}
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    }
  }
}
