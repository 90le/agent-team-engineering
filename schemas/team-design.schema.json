{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:team-design:1.0.0",
  "title": "Context-first Agent Team design",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "team_id", "display_name", "summary", "mode", "preset", "owner", "project", "platform_targets", "principles", "workflow", "roles", "knowledge_sources"],
  "properties": {
    "$schema": {"const": "urn:agent-team:schema:team-design:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "team_id": {"type": "string", "pattern": "^team\\.[a-z0-9][a-z0-9.-]*$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "mode": {"enum": ["lite", "managed"]},
    "preset": {"enum": ["software-lite", "software-managed", "custom"]},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "approval_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^human\\.[a-z0-9][a-z0-9.-]*$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "approval_required": {"const": true}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "provider", "repository", "default_branch"],
      "properties": {
        "id": {"type": "string", "pattern": "^project\\.[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "provider": {"enum": ["github", "gitlab", "gitea", "generic-git"]},
        "repository": {"type": "string", "minLength": 1, "maxLength": 1000},
        "default_branch": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "platform_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["openclaw", "codex", "claude", "generic-ai"]}
    },
    "principles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "trigger", "stages", "stop_after"],
      "properties": {
        "id": {"type": "string", "pattern": "^workflow\\.[a-z0-9][a-z0-9.-]*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 500},
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "owner_role", "produces", "approval"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "owner_role": {"type": "string", "pattern": "^(human\\.[a-z0-9][a-z0-9.-]*|[a-z][a-z0-9-]*)$"},
              "produces": {"type": "string", "minLength": 1, "maxLength": 500},
              "approval": {"enum": ["none", "human"]}
            }
          }
        },
        "stop_after": {"enum": ["draft-pr", "human-defined"]}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "mission", "responsibilities", "inputs", "outputs", "read_set", "skills", "allowed_tools", "forbidden_actions", "handoffs", "success_conditions", "stop_conditions", "engine", "model", "reasoning_effort", "sandbox_mode", "managed_role"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
          "mission": {"type": "string", "minLength": 1, "maxLength": 1000},
          "responsibilities": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "inputs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "outputs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "read_set": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "skills": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
          "allowed_tools": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
          "forbidden_actions": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "handoffs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["to", "when", "deliverable"],
              "properties": {
                "to": {"type": "string", "pattern": "^(human\\.[a-z0-9][a-z0-9.-]*|[a-z][a-z0-9-]*)$"},
                "when": {"type": "string", "minLength": 1, "maxLength": 500},
                "deliverable": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          },
          "success_conditions": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "engine": {"enum": ["openclaw", "codex", "claude", "generic-ai"]},
          "model": {"type": ["string", "null"], "maxLength": 200},
          "reasoning_effort": {"enum": ["inherit", "low", "medium", "high", "xhigh", "max", "ultra"]},
          "sandbox_mode": {"enum": ["read-only", "workspace-write"]},
          "managed_role": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"}
        }
      }
    },
    "knowledge_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "purpose", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^knowledge\\.[a-z0-9][a-z0-9.-]*$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
