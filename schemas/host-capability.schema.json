{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:host-capability:1.0.0",
  "title": "AI Host Capability Descriptor",
  "description": "Versioned, data-only description of an AI host's native team surfaces and safe local version probe.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "host_id", "display_name", "description", "support_tier", "integration_mode", "probe", "capabilities", "native_surfaces", "tested_versions", "upstream", "license", "limitations", "safety"],
  "properties": {
    "$schema": {"const": "urn:agent-team:schema:host-capability:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "host_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "support_tier": {"enum": ["native-verified", "native-install-verified", "verified-export", "experimental-plan", "portable", "research-unknown"]},
    "integration_mode": {"enum": ["native-files", "native-cli-plan", "overlay", "portable"]},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "command", "timeout_seconds"],
      "properties": {
        "mode": {"enum": ["version-command", "unavailable"]},
        "command": {
          "type": "array",
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}
    },
    "native_surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 200}
    },
    "tested_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "observed_output", "observed_at", "scope"],
        "properties": {
          "version": {"type": "string", "minLength": 1, "maxLength": 100},
          "observed_output": {"type": "string", "minLength": 1, "maxLength": 300},
          "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "scope": {"enum": ["local-version-probe", "upstream-contract-review", "isolated-load-test"]}
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 300},
        "pinned_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "pinned_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "identifier", "source"],
      "properties": {
        "classification": {"enum": ["permissive-open-source", "proprietary", "custom-source-available", "not-applicable", "unknown"]},
        "identifier": {"type": "string", "minLength": 1, "maxLength": 120},
        "source": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_reads_configuration", "probe_reads_credentials", "probe_uses_network", "probe_mutates_state"],
      "properties": {
        "probe_reads_configuration": {"const": false},
        "probe_reads_credentials": {"const": false},
        "probe_uses_network": {"const": false},
        "probe_mutates_state": {"const": false}
      }
    }
  }
}
