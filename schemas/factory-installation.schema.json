{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:factory-installation:1.0.0",
  "title": "Immutable Agent Team Factory installation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation_id", "factory_id", "factory_version", "source_revision", "source_tag", "release_verified", "tree_digest", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "installation_id": {"type": "string", "pattern": "^installation-[a-f0-9]{32}$"},
    "factory_id": {"type": "string", "pattern": "^factory\\.[a-z0-9][a-z0-9.-]*$"},
    "factory_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_tag": {"type": ["string", "null"], "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "release_verified": {"type": "boolean"},
    "tree_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mode", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "mode": {"enum": [420, 493]},
          "size": {"type": "integer", "minimum": 0, "maximum": 10485760}
        }
      }
    }
  }
}
