{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:control-plane-status:1.0.0",
  "title": "Non-secret control-plane status",
  "type": "object",
  "additionalProperties": false,
  "required": ["database_schema_version", "paused", "pause_reason", "changed_by", "changed_at", "work_items", "active_leases", "outbox", "audit_events", "audit_head"],
  "properties": {
    "database_schema_version": {"type": "integer", "minimum": 1},
    "paused": {"type": "boolean"},
    "pause_reason": {"type": ["string", "null"]},
    "changed_by": {"type": ["string", "null"]},
    "changed_at": {"type": "string", "minLength": 1},
    "work_items": {"type": "object"},
    "active_leases": {"type": "integer", "minimum": 0},
    "outbox": {"type": "object"},
    "audit_events": {"type": "integer", "minimum": 0},
    "audit_head": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
