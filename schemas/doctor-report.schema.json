{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:doctor-report:1.0.0",
  "title": "Agent Team Factory diagnostic report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "overall", "python", "git", "docker", "gh", "root", "factory_id", "factory_version", "factory_contract_digest", "production_integrations_enabled", "source", "instance", "checks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "overall": {"enum": ["PASS", "WARN", "FAIL"]},
    "python": {"type": "string", "minLength": 1},
    "git": {"type": ["string", "null"]},
    "docker": {"type": ["string", "null"]},
    "gh": {"type": ["string", "null"]},
    "root": {"type": "string", "minLength": 1},
    "factory_id": {"type": "string", "pattern": "^factory\\.[a-z0-9][a-z0-9.-]*$"},
    "factory_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "factory_contract_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "production_integrations_enabled": {"const": false},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "revision", "dirty", "release_verified", "tag"],
      "properties": {
        "mode": {"enum": ["git-worktree", "installed-distribution", "unknown"]},
        "revision": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]},
        "release_verified": {"type": "boolean"},
        "tag": {"type": ["string", "null"]}
      }
    },
    "instance": {"type": ["object", "null"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary", "remediation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
          "status": {"enum": ["PASS", "WARN", "FAIL"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "remediation": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    }
  }
}
