{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-team:schema:cross-ai-takeover:1.0.0",
  "title": "Cross-AI cold-start takeover acceptance profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "purpose", "entrypoints", "required_documents", "context_roles", "automated_assertions", "human_replay_required"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "id": {"const": "acceptance.cross-ai-takeover"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "entrypoints": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "path", "authority"],
        "properties": {
          "platform": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 200},
          "authority": {"enum": ["primary", "thin-adapter"]}
        }
      }
    },
    "required_documents": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "context_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "automated_assertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}
    },
    "human_replay_required": {"const": true}
  }
}
