{
  "schema_version": "2.0.0",
  "id": "adapter.codex",
  "version": "0.4.0",
  "kind": "agent-provider",
  "status": "REFERENCE",
  "authority": "replaceable-interface",
  "slots": ["model"],
  "config_schema": "schemas/adapter-empty-config.schema.json",
  "operations": [
    {
      "name": "agent.invoke",
      "slots": ["model"],
      "direction": "outbound",
      "external_effect": "compute",
      "delivery": "at-most-once",
      "capability": "agent.invoke",
      "input_schema": "schemas/project-task-envelope.schema.json",
      "output_schema": "schemas/agent-result.schema.json",
      "timeout_seconds": 3600,
      "project_scope": {"match_by": "id", "payload_field": "project_id", "provider": null, "allowed_modes": ["observe", "proposal-only"], "default_branch_field": null, "source_ref_field": null}
    }
  ],
  "trust_boundaries": ["control-worker", "provider-api"],
  "credentials": ["model-provider-credential"],
  "implementation": {"mode": "contract-only", "entrypoint": null},
  "security_notes": [
    "AGENTS.md is a discovery adapter, not a permission system.",
    "Actual filesystem and tool permissions must match the task envelope.",
    "A model response is a proposal and never an approval assertion."
  ]
}
